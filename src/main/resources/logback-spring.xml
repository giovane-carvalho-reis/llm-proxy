<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty name="LOG_FORMAT" source="LOG_FORMAT" defaultValue="json"/>
    <springProperty name="LOG_LEVEL" source="LOG_LEVEL" defaultValue="INFO"/>

    <appender name="STDOUT_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>ts</timestamp>
                <logger>logger</logger>
                <message>msg</message>
                <stackTrace>exc</stackTrace>
            </fieldNames>
            <customFields>{"pid":"${PID}"}</customFields>
        </encoder>
    </appender>

    <appender name="STDOUT_TEXT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p ${PID} --- [%15.15t] %-40.40logger{39} : %m%n</pattern>
        </encoder>
    </appender>

    <if condition='property("LOG_FORMAT").equals("text")'>
        <then>
            <root level="${LOG_LEVEL}">
                <appender-ref ref="STDOUT_TEXT"/>
            </root>
        </then>
        <else>
            <root level="${LOG_LEVEL}">
                <appender-ref ref="STDOUT_JSON"/>
            </root>
        </else>
    </if>
</configuration>