[Unit]
Description=llama-swap — on-demand llama-server supervisor (qwen3-14b <-> qwen3-35b, :8080)
After=network.target

[Service]
ExecStart=%h/Documentos/Repo/llama-swap/llama-swap \
  --config %h/Documentos/Repo/llm-proxy/llama-swap.yaml \
  --listen 127.0.0.1:8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
