[Unit]
Description=llm-embed — bge-m3 embedding server, always-on (:8082)
After=network.target

[Service]
# Flags copied verbatim from cvm-pdf-processor/scripts/start-embed-server-gpu.sh
# (-c = np * 8192 = 4 * 8192 = 32768).
ExecStart=%h/Documentos/Repo/llama.cpp/build/bin/llama-server \
  -m %h/Documentos/Repo/Models-llm/bge-m3-Q8_0.gguf \
  --embedding --pooling mean \
  -ngl 99 \
  -c 32768 \
  -t 4 \
  -b 512 -ub 512 \
  -np 4 \
  --threads-http 4 \
  --host 127.0.0.1 \
  --port 8082
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
